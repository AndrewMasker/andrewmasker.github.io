{% comment %}
  One image or video column for figure_slot.liquid.
  Parameters: path (site-relative file path), alt, width (optional Bootstrap column count out of 12).
  .mp4, .webm, and .mov files render as silent looping videos; anything else goes through figure.liquid.
{% endcomment %}
{%- assign fsm_ext = include.path | split: '.' | last | downcase -%}
{%- if include.width -%}
  {%- capture fsm_col %}col-sm-{{ include.width }}{% endcapture -%}
{%- else -%}
  {%- assign fsm_col = 'col-sm' -%}
{%- endif %}
<div class="{{ fsm_col }} mt-3 mt-md-0">
  {%- if fsm_ext == 'mp4' or fsm_ext == 'webm' or fsm_ext == 'mov' %}
    <figure>
      <video
        src="{{ include.path | relative_url }}"
        class="img-fluid rounded z-depth-1"
        aria-label="{{ include.alt }}"
        autoplay
        muted
        loop
        playsinline
        controls
        preload="metadata"
      ></video>
    </figure>
  {%- else %}
    {% include figure.liquid path=include.path alt=include.alt class="img-fluid rounded z-depth-1" zoomable=true %}
  {%- endif %}
</div>
