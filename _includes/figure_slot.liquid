{% comment %}
  A figure (one image or video, or two side by side) that shows up once its files exist.

  Usage:
    {% include figure_slot.liquid file="machine_overview.jpg" note="What the photo should show" caption="Caption text." %}
    {% include figure_slot.liquid file="a.jpg" file2="b.mp4" caption="Left: ... Right: ..." %}

  Parameters:
    file, file2     file names, relative to `dir` (file2 is optional). .mp4/.webm/.mov render as silent looping videos.
    dir             folder holding the files; defaults to the page's `figure_dir` front matter
    width, width2   optional Bootstrap column widths out of 12 (e.g. width="6" for a tall portrait photo, or
                    width="5" width2="7" to balance two pictures with different aspect ratios); the row is centered
    note, note2     what each file should show (only used for the placeholder)
    caption         caption shown under the figure
    alt, alt2       optional alt text; defaults to the caption

  Behavior:
    - Every file is in the folder: the figure and caption render normally (photos are click-to-zoom).
    - Any file missing, production build (JEKYLL_ENV=production, i.e. the live site): nothing renders.
    - Any file missing, local preview: a dashed placeholder box with the note and the expected path.
{% endcomment %}
{%- assign fs_dir = include.dir | default: page.figure_dir -%}
{%- capture fs_path1 %}{{ fs_dir }}/{{ include.file }}{% endcapture -%}
{%- assign fs_key1 = fs_path1 | prepend: '/' -%}
{%- assign fs_has1 = site.static_files | where: 'path', fs_key1 | size -%}
{%- assign fs_ready = false -%}
{%- if include.file2 -%}
  {%- capture fs_path2 %}{{ fs_dir }}/{{ include.file2 }}{% endcapture -%}
  {%- assign fs_key2 = fs_path2 | prepend: '/' -%}
  {%- assign fs_has2 = site.static_files | where: 'path', fs_key2 | size -%}
  {%- if fs_has1 > 0 and fs_has2 > 0 -%}{%- assign fs_ready = true -%}{%- endif -%}
{%- else -%}
  {%- if fs_has1 > 0 -%}{%- assign fs_ready = true -%}{%- endif -%}
{%- endif -%}
{%- assign fs_alt1 = include.alt | default: include.caption | strip_html -%}
{%- assign fs_alt2 = include.alt2 | default: include.caption | strip_html -%}
{%- assign fs_row = 'row' -%}
{%- if include.width or include.width2 -%}{%- assign fs_row = 'row justify-content-center' -%}{%- endif -%}
{%- if fs_ready %}
  <div class="{{ fs_row }}">
    {% include figure_slot_media.liquid path=fs_path1 alt=fs_alt1 width=include.width %}
    {%- if include.file2 %}
      {% include figure_slot_media.liquid path=fs_path2 alt=fs_alt2 width=include.width2 %}
    {%- endif %}
  </div>
  <div class="caption">
    {{ include.caption }}
  </div>
{%- elsif jekyll.environment != 'production' %}
  <div class="row">
    <div class="col-sm mt-3 mt-md-0">
      <div class="img-placeholder">
        <strong>Image placeholder:</strong> {{ include.note -}}
        <br>
        <code>{{ fs_path1 }}</code>
      </div>
    </div>
    {%- if include.file2 %}
      <div class="col-sm mt-3 mt-md-0">
        <div class="img-placeholder">
          <strong>Image placeholder:</strong> {{ include.note2 -}}
          <br>
          <code>{{ fs_path2 }}</code>
        </div>
      </div>
    {%- endif %}
  </div>
  <div class="caption">
    {{ include.caption }}
  </div>
{%- endif %}
